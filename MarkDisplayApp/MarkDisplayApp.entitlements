<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is intentionally disabled.
	     MarkDisplayApp requires NSEvent.addGlobalMonitorForEvents to register
	     global keyboard shortcuts that fire outside the app's own windows.
	     This API is not available to sandboxed applications. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
